# Database Configuration
# This matches the postgres service defined in compose.yaml
# .env.example  (nur Platzhalter, die echten Werte kommen in .env)
POSTGRES_PASSWORD=change-me
SQLALCHEMY_DATABASE_URL=postgresql://postgres:change-me@localhost:5431/RouteFlowAI-postgres

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
